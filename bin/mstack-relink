#!/usr/bin/env bash
# mstack-relink - recreate Claude skill links from SKILL.md frontmatter names
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
MSTACK_CONFIG="${SCRIPT_DIR}/mstack-config"

INSTALL_DIR="${MSTACK_INSTALL_DIR:-}"
if [ -z "$INSTALL_DIR" ]; then
  if [ -f "$HOME/.claude/skills/mstack/bin/mstack-relink" ]; then
    INSTALL_DIR="$HOME/.claude/skills/mstack"
  elif [ -d "${SCRIPT_DIR}/.." ] && [ -f "${SCRIPT_DIR}/../setup" ]; then
    INSTALL_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
  fi
fi

if [ -z "$INSTALL_DIR" ] || [ ! -d "$INSTALL_DIR" ]; then
  echo "Error: mstack install directory not found." >&2
  exit 1
fi

SKILLS_DIR="${MSTACK_SKILLS_DIR:-$HOME/.claude/skills}"
mkdir -p "$SKILLS_DIR"

PREFIX="$("$MSTACK_CONFIG" get skill_prefix 2>/dev/null || echo true)"
[ -n "$PREFIX" ] || PREFIX=true

skill_name_from_file() {
  awk -F': *' '/^name:/{print $2; exit}' "$1" | tr -d '\r'
}

public_skill_name() {
  local name="$1"
  if [ "$PREFIX" = "true" ]; then
    printf '%s\n' "$name"
    return
  fi
  case "$name" in
    mstack) printf '%s\n' "$name" ;;
    m-*) printf '%s\n' "${name#m-}" ;;
    *) printf '%s\n' "$name" ;;
  esac
}

link_file() {
  local src="$1"
  local dst="$2"
  mkdir -p "$(dirname "$dst")"
  if [ -L "$dst" ] || [ -f "$dst" ]; then
    rm -f "$dst"
  fi
  if ! ln -s "$src" "$dst" 2>/dev/null; then
    cp "$src" "$dst"
  fi
}

COUNT=0
if [ -f "$INSTALL_DIR/SKILL.md" ]; then
  link_file "$INSTALL_DIR/SKILL.md" "$SKILLS_DIR/mstack/SKILL.md"
fi

for file in "$INSTALL_DIR"/*/SKILL.md; do
  [ -f "$file" ] || continue
  name="$(skill_name_from_file "$file")"
  [ -n "$name" ] || continue
  link_name="$(public_skill_name "$name")"
  link_file "$file" "$SKILLS_DIR/$link_name/SKILL.md"
  COUNT=$((COUNT + 1))
done

if [ "$PREFIX" = "true" ]; then
  echo "Relinked $COUNT skills as /m-* names"
else
  echo "Relinked $COUNT skills as short names"
fi
