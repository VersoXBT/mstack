#!/usr/bin/env bash
# mstack-config - read/write ~/.mstack/config.yaml
set -euo pipefail

STATE_DIR="${MSTACK_STATE_DIR:-$HOME/.mstack}"
CONFIG_FILE="$STATE_DIR/config.yaml"

CONFIG_HEADER='# mstack configuration - edit freely, changes take effect on next skill run.
# Docs: https://github.com/VersoXBT/mstack
#
# Behavior
# proactive: true           # Auto-suggest skills when your request matches one.
# routing_declined: false   # Skip project routing prompt when true.
#
# Privacy
# telemetry: off            # Compatibility key. mstack sends no telemetry.
#
# Updates
# auto_upgrade: false       # true = silently upgrade on session start.
# update_check: false       # false = suppress network version checks.
#
# Skill naming
# skill_prefix: true        # true = /m-write, /m-audit, /m-ads.
#                           # false = /write, /audit, /ads.
#
# Advanced
# browse_path: ""           # Optional browser helper path.
# default_language: "en"    # Default output language.
#
'

get_value() {
  local key="$1"
  grep -E "^${key}:" "$CONFIG_FILE" 2>/dev/null | tail -1 | sed "s/^${key}:[[:space:]]*//" | tr -d '\r' || true
}

validate_key() {
  local key="$1"
  if ! printf '%s' "$key" | grep -qE '^[a-zA-Z0-9_]+$'; then
    echo "Error: key must contain only alphanumeric characters and underscores" >&2
    exit 1
  fi
}

case "${1:-}" in
  get)
    KEY="${2:?Usage: mstack-config get <key>}"
    validate_key "$KEY"
    get_value "$KEY"
    ;;
  set)
    KEY="${2:?Usage: mstack-config set <key> <value>}"
    VALUE="${3:?Usage: mstack-config set <key> <value>}"
    validate_key "$KEY"
    mkdir -p "$STATE_DIR"
    if [ ! -f "$CONFIG_FILE" ]; then
      printf '%s' "$CONFIG_HEADER" > "$CONFIG_FILE"
    fi
    ESC_VALUE="$(printf '%s' "$VALUE" | head -1 | sed 's/[&/\]/\\&/g')"
    if grep -qE "^${KEY}:" "$CONFIG_FILE" 2>/dev/null; then
      tmpfile="$(mktemp "${CONFIG_FILE}.XXXXXX")"
      sed "/^${KEY}:/s/.*/${KEY}: ${ESC_VALUE}/" "$CONFIG_FILE" > "$tmpfile"
      mv "$tmpfile" "$CONFIG_FILE"
    else
      printf '%s: %s\n' "$KEY" "$VALUE" >> "$CONFIG_FILE"
    fi
    if [ "$KEY" = "skill_prefix" ] && [ -z "${MSTACK_SETUP_RUNNING:-}" ]; then
      MSTACK_RELINK="$(dirname "$0")/mstack-relink"
      [ -x "$MSTACK_RELINK" ] && "$MSTACK_RELINK" || true
    fi
    ;;
  list)
    cat "$CONFIG_FILE" 2>/dev/null || true
    ;;
  *)
    echo "Usage: mstack-config {get|set|list} [key] [value]"
    exit 1
    ;;
esac
