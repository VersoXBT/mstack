#!/usr/bin/env bash
# mstack-update-check - optional version check for mstack.
#
# Output:
#   JUST_UPGRADED <old> <new>
#   UPGRADE_AVAILABLE <old> <new>
#   nothing when disabled, cached, snoozed, invalid, or up to date
set -euo pipefail

MSTACK_DIR="${MSTACK_DIR:-$(cd "$(dirname "$0")/.." && pwd)}"
STATE_DIR="${MSTACK_STATE_DIR:-$HOME/.mstack}"
CACHE_FILE="$STATE_DIR/last-update-check"
MARKER_FILE="$STATE_DIR/just-upgraded-from"
SNOOZE_FILE="$STATE_DIR/update-snoozed"
VERSION_FILE="$MSTACK_DIR/VERSION"
REMOTE_URL="${MSTACK_REMOTE_URL:-https://raw.githubusercontent.com/VersoXBT/mstack/main/VERSION}"
FORCE=false

if [ "${1:-}" = "--force" ]; then
  FORCE=true
  rm -f "$CACHE_FILE" "$SNOOZE_FILE"
fi

UPDATE_CHECK="$("$MSTACK_DIR/bin/mstack-config" get update_check 2>/dev/null || true)"
if [ "$UPDATE_CHECK" = "false" ] && [ "$FORCE" != "true" ]; then
  exit 0
fi

check_snooze() {
  local remote_ver="$1"
  [ -f "$SNOOZE_FILE" ] || return 1
  local snoozed_ver snoozed_level snoozed_epoch
  snoozed_ver="$(awk '{print $1}' "$SNOOZE_FILE" 2>/dev/null || true)"
  snoozed_level="$(awk '{print $2}' "$SNOOZE_FILE" 2>/dev/null || true)"
  snoozed_epoch="$(awk '{print $3}' "$SNOOZE_FILE" 2>/dev/null || true)"
  [ -n "$snoozed_ver" ] && [ -n "$snoozed_level" ] && [ -n "$snoozed_epoch" ] || return 1
  case "$snoozed_level" in *[!0-9]*) return 1 ;; esac
  case "$snoozed_epoch" in *[!0-9]*) return 1 ;; esac
  [ "$snoozed_ver" = "$remote_ver" ] || return 1

  local duration
  case "$snoozed_level" in
    1) duration=86400 ;;
    2) duration=172800 ;;
    *) duration=604800 ;;
  esac

  local now expires
  now="$(date +%s)"
  expires=$((snoozed_epoch + duration))
  [ "$now" -lt "$expires" ]
}

LOCAL=""
if [ -f "$VERSION_FILE" ]; then
  LOCAL="$(tr -d '[:space:]' < "$VERSION_FILE" 2>/dev/null || true)"
fi
[ -n "$LOCAL" ] || exit 0

mkdir -p "$STATE_DIR"

if [ -f "$MARKER_FILE" ]; then
  OLD="$(tr -d '[:space:]' < "$MARKER_FILE" 2>/dev/null || true)"
  rm -f "$MARKER_FILE" "$SNOOZE_FILE"
  [ -n "$OLD" ] && echo "JUST_UPGRADED $OLD $LOCAL"
fi

if [ "$FORCE" != "true" ] && [ -f "$CACHE_FILE" ]; then
  CACHED="$(cat "$CACHE_FILE" 2>/dev/null || true)"
  case "$CACHED" in
    UP_TO_DATE*) CACHE_TTL=60 ;;
    UPGRADE_AVAILABLE*) CACHE_TTL=720 ;;
    *) CACHE_TTL=0 ;;
  esac

  STALE=$(find "$CACHE_FILE" -mmin +$CACHE_TTL 2>/dev/null || true)
  if [ -z "$STALE" ] && [ "$CACHE_TTL" -gt 0 ]; then
    case "$CACHED" in
      UP_TO_DATE*)
        CACHED_VER="$(echo "$CACHED" | awk '{print $2}')"
        [ "$CACHED_VER" = "$LOCAL" ] && exit 0
        ;;
      UPGRADE_AVAILABLE*)
        CACHED_OLD="$(echo "$CACHED" | awk '{print $2}')"
        if [ "$CACHED_OLD" = "$LOCAL" ]; then
          CACHED_NEW="$(echo "$CACHED" | awk '{print $3}')"
          check_snooze "$CACHED_NEW" && exit 0
          echo "$CACHED"
          exit 0
        fi
        ;;
    esac
  fi
fi

REMOTE="$(curl -sf --max-time 5 "$REMOTE_URL" 2>/dev/null || true)"
REMOTE="$(echo "$REMOTE" | tr -d '[:space:]')"
if ! echo "$REMOTE" | grep -qE '^[0-9]+\.[0-9.]+$'; then
  echo "UP_TO_DATE $LOCAL" > "$CACHE_FILE"
  exit 0
fi

if [ "$LOCAL" = "$REMOTE" ]; then
  echo "UP_TO_DATE $LOCAL" > "$CACHE_FILE"
  exit 0
fi

echo "UPGRADE_AVAILABLE $LOCAL $REMOTE" > "$CACHE_FILE"
check_snooze "$REMOTE" && exit 0
echo "UPGRADE_AVAILABLE $LOCAL $REMOTE"
